<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".presentation.ui.mission.PickedThemeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="80dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이미지를 생성하고 있어요!"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="AI가 배경을 만들고 이미지를 합성하는데 시간이 걸려요."
            android:textColor="@color/black"
            android:textSize="12sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="완성되면 가족 앨범에 추가돼요!"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/tx_animated"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:textAlignment="center"
            android:gravity="center"
            android:text="🖼"
            android:textSize="200dp"
            android:fontFamily="@font/tossfacefont"/>

    </LinearLayout>

    <Button
        android:id="@+id/btn_goto_home"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginStart="30dp"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="20dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_round_main"
        android:text="홈으로 돌아가기"
        android:textColor="#ffffff"
        android:textStyle="bold"
        android:padding="10dp"/>

</FrameLayout>