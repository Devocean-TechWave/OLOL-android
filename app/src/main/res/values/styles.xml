<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- 테마 선택 버튼 -->
  <style name="ThemeButton">
    <item name="android:layout_width">160dp</item>
    <item name="android:layout_height">70dp</item>
    <item name="android:layout_marginBottom">10dp</item>
    <item name="android:background">@drawable/bg_light_theme</item>
    <item name="android:textColor">@color/black</item>
    <item name="android:textSize">16sp</item>
    <item name="android:gravity">center</item>
  </style>
  <!-- 다음 버튼 -->
  <style name="NextButton">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:textColor">@color/white</item>
    <item name="cornerRadius">10dp</item>
    <item name="android:backgroundTint">@drawable/background_button_next</item>
    <item name="android:paddingVertical">18dp</item>
  </style>
</resources>